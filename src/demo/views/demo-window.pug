extends templates/layouts/_reveal.pug

append variables
	- presentation.title = presentation.title + ": custom with window style"

block slides
	include slides/_slides-window

block append scripts
	+revealsrc("script", "plugin/highlight/highlight.js")

	if process.env.NODE_ENV === 'production'
		script(src=`plugin/${plugin.name}/${plugin.name}.js`)
		script.
			Reveal.initialize({
				margin: 0.1, maxScale: 1.8, width: 1080, height: 700,
				history: true, center: true, controlsTutorial: false,
				plugins: [ CopyCode, RevealHighlight ],
				copycode: {
					timeout: 1200,
					button: "always", 
					display: "icons", 
					style: {
						copybg: "transparent", 
						copiedbg: "transparent", 
						copycolor: "white",
						copiedcolor: "white",
					},
					window: {
						controls: "light",
						controlsOpacity: 0.5,
						padding: "1rem"
					}
				}
			});
	else
		script(type="module").
			import CopyCode from '@/plugin/js/index';
			Reveal.initialize({
				margin: 0.1, maxScale: 1.8, width: 1080, height: 700,
				history: true, center: true, controlsTutorial: false,
				plugins: [ CopyCode, RevealHighlight ],
				copycode: {
					debug: true,
					cssautoload: false,
					timeout: 1200,
					button: "always",
					display: "icons",
					style: {
						copybg: "transparent", 
						copiedbg: "transparent", 
						copycolor: "white",
						copiedcolor: "white",
					},
					window: {
						controls: "light",
						controlsOpacity: 0.5,
						padding: "1rem"
					}
				}
			});
